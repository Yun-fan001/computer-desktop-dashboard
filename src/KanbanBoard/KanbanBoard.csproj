<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>KanbanBoard</RootNamespace>
    <AssemblyName>KanbanBoard</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyTitle>桌面看板 KanbanBoard</AssemblyTitle>
    <Product>桌面看板 KanbanBoard</Product>
    <Description>极简可扩展的 Windows 桌面悬浮看板</Description>
    <Company>KanbanBoard</Company>
    <Copyright>© 2026 KanbanBoard</Copyright>
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <None Include="Resources\App.ico" Link="App.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
