<Window x:Class="KanbanBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KanbanBoard.Controls"
        Title="看板"
        Width="300" Height="44"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid x:Name="Root">
        <!-- 悬浮条 -->
        <Border x:Name="CollapsedPanel" Background="{DynamicResource Brush.PanelBackground}" CornerRadius="12"
                Padding="16,9" MouseLeftButtonDown="Bar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TimeText}" FontWeight="Bold" FontSize="14"
                           Foreground="{DynamicResource Brush.ForegroundPrimary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TodayLabel" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"
                           Margin="14,0,4,0" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource Brush.Accent}" CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TodayCount}" Foreground="{DynamicResource Brush.AccentForeground}" FontSize="11"/>
                </Border>
                <Button x:Name="QuickAddBtn" Style="{StaticResource IconButton}" FontSize="15" Content="＋"
                        Click="QuickAdd_Click" Margin="12,0,0,0"/>
                <Button x:Name="ExpandBtn" Style="{StaticResource IconButton}" FontSize="11" Content="▾"
                        Click="Expand_Click" Margin="0,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 展开工作台 -->
        <Border x:Name="ExpandedPanel" Background="{DynamicResource Brush.WindowBackground}" CornerRadius="12"
                Padding="14" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="▸" Click="Collapse_Click"/>
                    <ComboBox x:Name="FilterCombo" DockPanel.Dock="Left" Width="88" Margin="4,0,0,0" VerticalAlignment="Center"
                              SelectionChanged="FilterCombo_SelectionChanged"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⚙" Click="Settings_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="📝" Click="Notes_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="＋" Click="QuickAdd_Click"/>
                    <Button x:Name="ViewToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="列表"
                            Click="ViewToggle_Click" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="6,0"
                             VerticalContentAlignment="Center"/>
                </DockPanel>

                <Grid x:Name="KanbanGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:KanbanColumn x:Name="TodoCol" Grid.Column="0"/>
                    <controls:KanbanColumn x:Name="DoingCol" Grid.Column="2"/>
                    <controls:KanbanColumn x:Name="DoneCol" Grid.Column="4"/>
                </Grid>

                <ListBox x:Name="BoardList" Grid.Row="1" Visibility="Collapsed"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate><controls:TaskCard/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox x:Name="FilterList" Grid.Row="1" Visibility="Collapsed"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.CardBackground}" CornerRadius="8"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    Padding="10,8" Margin="2,0,2,6">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="恢复" Style="{StaticResource IconButton}" Tag="{Binding}" Click="Restore_Click"/>
                                        <Button Content="删除" Style="{StaticResource IconButton}" Foreground="{DynamicResource Brush.Danger}" Tag="{Binding}" Click="Delete_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.ForegroundPrimary}"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="CalendarPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:CalendarView x:Name="Calendar" Grid.Column="0"/>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"
                                   Foreground="{DynamicResource Brush.ForegroundPrimary}"
                                   Text="{Binding SelectedDateText}"/>
                        <ListBox x:Name="SelectedDayList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate><controls:TaskCard/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>

                <Grid x:Name="SchedulePanel" Grid.Row="1" Visibility="Collapsed">
                    <controls:ScheduleView x:Name="Schedule"/>
                </Grid>

                <TextBlock x:Name="MonitorText" Grid.Row="2" Margin="2,8,2,0" FontSize="11"
                           Foreground="{DynamicResource Brush.ForegroundSecondary}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>

