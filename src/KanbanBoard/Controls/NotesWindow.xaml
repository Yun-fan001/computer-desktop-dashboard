<Window x:Class="KanbanBoard.Controls.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Width="720" Height="520"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.ForegroundPrimary}"
        Title="便签">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            <Button x:Name="NewBtn" Content="＋ 新建" Style="{StaticResource PrimaryButton}" Click="New_Click" Margin="12,0,0,0"/>
        </StackPanel>
        <ListBox x:Name="NoteList" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="NoteList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Color, Converter={StaticResource NoteColorToBrush}}"
                            CornerRadius="8" Padding="12,10" Margin="2,0,2,6">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <TextBlock Text="📌" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="×" Style="{StaticResource IconButton}" Tag="{Binding}" Click="Delete_Click"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" Foreground="#FF333333"/>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Opacity="0.7" MaxHeight="56"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="#FF333333"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
