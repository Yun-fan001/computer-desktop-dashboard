<Window x:Class="KanbanBoard.Controls.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Width="520" Height="680"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.ForegroundPrimary}"
        Title="设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock x:Name="HeaderText" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>

            <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="主题" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <ComboBox x:Name="ThemeCombo" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="材质" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <ComboBox x:Name="MaterialCombo" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="透明度" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
            <DockPanel Margin="0,0,0,14">
                <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center"/>
                <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" ValueChanged="Opacity_Changed"/>
            </DockPanel>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="语言" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <ComboBox x:Name="LanguageCombo" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="字体缩放" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <ComboBox x:Name="FontScaleCombo" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="交互" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="悬停展开延迟(ms)" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <TextBox x:Name="ExpandDelayBox" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="移开收起延迟(ms)" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <TextBox x:Name="CollapseDelayBox" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="快捷键" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="快速添加" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <TextBox x:Name="QuickAddHotkeyBox" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="显示/隐藏" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <TextBox x:Name="ToggleHotkeyBox" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="命令面板快捷键" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
            <TextBox x:Name="CommandPaletteHotkeyBox" Margin="0,4,0,14"/>

            <TextBlock Text="启动与数据" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <CheckBox x:Name="AutoStartCheck" Content="开机自启" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <CheckBox x:Name="AutoStartDelayCheck" Content="延迟启动(秒)" VerticalAlignment="Center"/>
                <TextBox x:Name="AutoStartDelayBox" Width="60" Margin="8,0,0,0"/>
            </StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="备份保留天数(7-30)" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <TextBox x:Name="BackupDaysBox" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <CheckBox x:Name="AutoBackupCheck" Content="自动备份" Margin="0,8,0,0"/>
                    <CheckBox x:Name="ReportCheck" Content="匿名崩溃上报" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="取消" Style="{StaticResource IconButton}" Click="Cancel_Click"/>
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
