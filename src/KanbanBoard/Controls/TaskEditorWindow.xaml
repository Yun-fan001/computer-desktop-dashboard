<Window x:Class="KanbanBoard.Controls.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Width="480" Height="620" MinWidth="420"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.ForegroundPrimary}"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <TextBlock x:Name="HeaderText" FontWeight="Bold" FontSize="16" Margin="0,0,0,14"/>

            <TextBlock Text="标题" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
            <TextBox x:Name="TitleBox" Margin="0,4,0,12" FontSize="14"/>

            <TextBlock Text="描述" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
            <TextBox x:Name="DescBox" Margin="0,4,0,12" AcceptsReturn="True" Height="60"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="优先级" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <ComboBox x:Name="PriorityCombo" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="重复" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <ComboBox x:Name="RepeatCombo" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="截止日期" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <DatePicker x:Name="DueDatePicker" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="时间" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <TextBox x:Name="DueTimeBox" Margin="0,4,0,0" Text="" ToolTip="HH:mm，留空表示仅日期"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="标签（空格或 # 分隔）" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
            <TextBox x:Name="TagsBox" Margin="0,4,0,12" FontSize="13"/>

            <TextBlock Text="子任务" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
            <ListBox x:Name="SubtaskList" Margin="0,4,0,6" MaxHeight="120" BorderBrush="{DynamicResource Brush.Border}"
                     BorderThickness="1" Background="{DynamicResource Brush.CardBackground}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource IconButton}" Click="AddSubtask_Click" FontSize="16"/>
                <TextBox x:Name="SubtaskInput" KeyDown="SubtaskInput_KeyDown" ToolTip="输入子任务后回车添加"/>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeleteBtn" Content="删除" Style="{StaticResource IconButton}" Foreground="{DynamicResource Brush.Danger}" Click="Delete_Click" Visibility="Collapsed"/>
                <Button Content="取消" Style="{StaticResource IconButton}" Click="Cancel_Click"/>
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
