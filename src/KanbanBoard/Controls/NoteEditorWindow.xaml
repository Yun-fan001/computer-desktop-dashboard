<Window x:Class="KanbanBoard.Controls.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Width="420" Height="480"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.ForegroundPrimary}"
        Title="便签">
    <StackPanel Margin="18">
        <TextBlock x:Name="HeaderText" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>

        <TextBlock Text="标题" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
        <TextBox x:Name="TitleBox" Margin="0,4,0,10" FontSize="14"/>

        <TextBlock Text="内容（支持 Markdown 文本）" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
        <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap" Height="180"
                 Margin="0,4,0,12" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Text="颜色" FontSize="12" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
        <StackPanel x:Name="ColorPanel" Orientation="Horizontal" Margin="0,6,0,12"/>

        <CheckBox x:Name="PinCheck" Content="置顶（贴桌面）" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DeleteBtn" Content="删除" Style="{StaticResource IconButton}"
                    Foreground="{DynamicResource Brush.Danger}" Click="Delete_Click" Visibility="Collapsed"/>
            <Button Content="取消" Style="{StaticResource IconButton}" Click="Cancel_Click"/>
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
