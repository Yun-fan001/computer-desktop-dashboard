<Window x:Class="KanbanBoard.Controls.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="200" Height="160"
        WindowStartupLocation="Manual">
    <Border x:Name="Root" CornerRadius="10" Padding="10"
            PreviewMouseLeftButtonDown="OnPreviewDown"
            PreviewMouseLeftButtonUp="OnPreviewUp"
            MouseMove="OnMouseMove"
            MouseLeftButtonDown="OnClick">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource IconButton}" FontSize="13"
                    HorizontalAlignment="Right" Click="Close_Click"/>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="ContentText" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="92"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
