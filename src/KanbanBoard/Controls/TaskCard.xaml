<UserControl x:Class="KanbanBoard.Controls.TaskCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Card"
            Background="{DynamicResource Brush.CardBackground}"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border}"
            Padding="10,8"
            Margin="2,0,2,6"
            Cursor="Hand"
            PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
            PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
            MouseMove="OnMouseMove"
            MouseLeftButtonDown="OnCardClick"
            MouseRightButtonUp="OnCardRightClick">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,8,0"
                      IsChecked="{Binding IsCompleted, Mode=OneWay}" Click="CheckBox_Click"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.ForegroundPrimary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                             Fill="{Binding Priority, Converter={StaticResource PriorityToBrush}}"/>
                    <TextBlock Text="{Binding DueDate, Converter={StaticResource DueDateToText}}"
                               Foreground="{Binding DueDate, Converter={StaticResource DueDateToBrush}}"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Tags, Converter={StaticResource TagsToText}}"
                           Foreground="{DynamicResource Brush.ForegroundSecondary}"
                           FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
