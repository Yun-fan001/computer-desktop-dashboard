<Window x:Class="KanbanBoard.Controls.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Width="460">
    <Border Background="{DynamicResource Brush.PanelBackground}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,12"
            Margin="8">
        <StackPanel>
            <TextBlock x:Name="HintText" Foreground="{DynamicResource Brush.ForegroundSecondary}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBox x:Name="Input" FontSize="15" KeyDown="OnKeyDown"
                     Foreground="{DynamicResource Brush.ForegroundPrimary}"/>
            <TextBlock x:Name="PreviewText" Foreground="{DynamicResource Brush.Accent}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
