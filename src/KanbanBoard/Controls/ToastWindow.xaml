<Window x:Class="KanbanBoard.Controls.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Width="320">
    <Border Background="{DynamicResource Brush.PanelBackground}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,10"
            Margin="8">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="13"
                       Foreground="{DynamicResource Brush.ForegroundPrimary}" TextWrapping="Wrap"/>
            <TextBlock x:Name="BodyText" Margin="0,4,0,0" FontSize="12"
                       Foreground="{DynamicResource Brush.ForegroundSecondary}" TextWrapping="Wrap" MaxHeight="90"/>
            <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="SnoozeBtn" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="Snooze_Click"/>
                <Button x:Name="CompleteBtn" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="Complete_Click"/>
                <Button x:Name="DismissBtn" Style="{StaticResource IconButton}" Click="Dismiss_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
