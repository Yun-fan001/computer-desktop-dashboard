<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 默认回退调色板（暗色），供未合并主题字典时兜底 -->
    <Color x:Key="Color.WindowBackground">#FF1E1E22</Color>
    <Color x:Key="Color.PanelBackground">#FF26262C</Color>
    <Color x:Key="Color.CardBackground">#FF2F2F36</Color>
    <Color x:Key="Color.HoverBackground">#33FFFFFF</Color>
    <Color x:Key="Color.Border">#33FFFFFF</Color>
    <Color x:Key="Color.ForegroundPrimary">#FFF2F2F2</Color>
    <Color x:Key="Color.ForegroundSecondary">#FF9C9CA3</Color>
    <Color x:Key="Color.Accent">#FF4C8DFF</Color>
    <Color x:Key="Color.AccentForeground">#FFFFFFFF</Color>
    <Color x:Key="Color.Danger">#FFFF6B6B</Color>
    <Color x:Key="Color.Success">#FF4CC98B</Color>

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{DynamicResource Color.WindowBackground}"/>
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="{DynamicResource Color.PanelBackground}"/>
    <SolidColorBrush x:Key="Brush.CardBackground" Color="{DynamicResource Color.CardBackground}"/>
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="{DynamicResource Color.HoverBackground}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.ForegroundPrimary" Color="{DynamicResource Color.ForegroundPrimary}"/>
    <SolidColorBrush x:Key="Brush.ForegroundSecondary" Color="{DynamicResource Color.ForegroundSecondary}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="{DynamicResource Color.AccentForeground}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}"/>

    <!-- 通用样式 -->
    <Style TargetType="Button" x:Key="IconButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundPrimary}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.HoverBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.ForegroundPrimary}"/>
    </Style>

</ResourceDictionary>